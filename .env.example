# Скопіюйте у .env і заповніть. Файл .env не комітиться.

# Домен сайту (DNS A-запис має вказувати на сервер). Caddy сам отримає HTTPS-сертифікат.
DOMAIN=nmt.example.com

DB_USERNAME=nmt
DB_PASSWORD=змініть-на-довгий-пароль

# Секрет підпису токенів: base64, щонайменше 32 байти. Згенерувати: openssl rand -base64 48
JWT_SECRET=

# Пароль початкового акаунта вчителя (логін: teacher). Змініть після першого входу в Профілі.
BOOTSTRAP_TEACHER_PASSWORD=
