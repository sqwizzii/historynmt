# Скопіюйте у .env і заповніть. Файл .env не комітиться.

# Доменне ім'я сайту (Caddy автоматично отримає HTTPS-сертифікат) і повна адреса сайту.
DOMAIN=history.example.com
PUBLIC_URL=https://history.example.com

# Пароль до бази даних.
POSTGRES_PASSWORD=change-me

# Секрет підпису JWT, Base64, щонайменше 256 біт. Згенерувати: openssl rand -base64 48
JWT_SECRET=

# Необов'язково: початковий акаунт вчителя (логін teacher) лише при BOOTSTRAP_TEACHER_ENABLED=true і паролі від 8 символів.
# Зазвичай не потрібно: вчителі реєструються самостійно, а підписку активує адміністратор.
BOOTSTRAP_TEACHER_ENABLED=false
BOOTSTRAP_TEACHER_PASSWORD=

# --- Етап 2: власність матеріалів і адміністратор ---

# Логін ІСНУЮЧОГО вчителя (роль TEACHER), якому належать усі матеріали й учні, створені до запровадження власності.
# Обов'язково при першому запуску на БД із даними, інакше застосунок не стартує (LEGACY_STRICT=true у prod).
# Не припускайте, що це "teacher": перевірте реальний логін у БД.
LEGACY_TEACHER_USERNAME=
# Лише якщо в БД кілька вчителів і ви підтверджуєте прив'язку ВСІХ неприв'язаних учнів до LEGACY_TEACHER_USERNAME.
LEGACY_ASSIGN_ALL_STUDENTS=false

# Окремий акаунт адміністратора платформи (системні матеріали). Пароль, щонайменше 12 символів, лише тут/у сховищі секретів.
# Наявному користувачеві роль не змінюється (див. ADMIN_PROMOTE_EXISTING у README).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PROMOTE_EXISTING=false

# Строк дії підписаних посилань на зображення приватних матеріалів, хвилин.
IMAGE_URL_TTL_MINUTES=360
